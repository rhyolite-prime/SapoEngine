{
  "name": "examples.sapoexpress_ussd_service",
  "version": "1.0",
  "description": "SapoExpress USSD menu flow for payments, vouchers, enterprise services, TL Banking, and account support.",
  "defaults": {
    "direct_receive_money_url": "https://api.example.test/v1/payments/direct-receive-money"
  },
  "nodes": [
    {
      "id": "main_menu",
      "type": "action",
      "capability": "",
      "label": "Welcome to SapoExpress",
      "await_input": true,
      "input_variable": "main_choice",
      "prompt_config": {
        "message": "Welcome to SapoExpress\n1. Pay a Merchant\n2. LM Banking\n3. WAEC Vouchers\n4. Enterprise\n5. My Account\n6. Payment Approvals\n7. Help and support",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_main"
    },
    {
      "id": "route_main",
      "type": "choice",
      "expression": "$main_choice",
      "cases": {
        "1": "pay_goods",
        "2": "tl_banking_menu",
        "3": "waec_menu",
        "4": "enterprise_menu",
        "5": "account_support_menu",
        "6": "payment_approvals",
        "7": "help_support"
      },
      "default": "main_menu"
    },
    {
      "id": "pay_goods",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Pay for Goods and Services is currently unavailable.",
        "action": "pay_goods"
      }
    },
    {
      "id": "payment_approvals",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "You have no pending payment approvals.",
        "action": "payment_approvals"
      }
    },
    {
      "id": "help_support",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "For help, contact SapoExpress customer support.",
        "action": "help_support"
      }
    },
    {
      "id": "waec_menu",
      "type": "action",
      "capability": "",
      "label": "WAEC Vouchers",
      "await_input": true,
      "input_variable": "waec_choice",
      "prompt_config": {
        "message": "WAEC Vouchers:\n1. Buy BECE/WASSCE/NOV DEC Checker\n2. Retrieve Lost Voucher\n3. Become a Wholesaler\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-3]$')",
        "timeout": "2m"
      },
      "next": "route_waec"
    },
    {
      "id": "route_waec",
      "type": "choice",
      "expression": "$waec_choice",
      "cases": {
        "0": "main_menu",
        "1": "waec_purchase_options",
        "2": "waec_recovery_transaction",
        "3": "waec_merchant_name"
      },
      "default": "waec_menu"
    },
    {
      "id": "waec_purchase_options",
      "type": "action",
      "capability": "",
      "label": "WAEC Purchase Options",
      "await_input": true,
      "input_variable": "waec_purchase_choice",
      "prompt_config": {
        "message": "Purchase Options:\n1. Buy for Self\n2. Buy in Bulk (Wholesaler)\n3. Affiliate Reseller (Earn Instantly)\n4. Wholesaler Dashboard\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-4]$')",
        "timeout": "2m"
      },
      "next": "route_waec_purchase"
    },
    {
      "id": "route_waec_purchase",
      "type": "choice",
      "expression": "$waec_purchase_choice",
      "cases": {
        "0": "waec_menu",
        "1": "waec_self_exam_menu",
        "2": "waec_bulk_notice",
        "3": "waec_affiliate_notice",
        "4": "waec_dashboard_notice"
      },
      "default": "waec_purchase_options"
    },
    {
      "id": "waec_self_exam_menu",
      "type": "action",
      "capability": "",
      "label": "Buy WAEC Voucher for Self",
      "await_input": true,
      "input_variable": "waec_exam_choice",
      "prompt_config": {
        "message": "Buy for Self:\n1. BECE\n2. WASSCE and NOV DEC\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-2]$')",
        "timeout": "2m"
      },
      "next": "route_waec_exam"
    },
    {
      "id": "route_waec_exam",
      "type": "choice",
      "expression": "$waec_exam_choice",
      "cases": {
        "0": "waec_purchase_options",
        "1": "waec_bece_selected",
        "2": "waec_wassce_selected"
      },
      "default": "waec_self_exam_menu"
    },
    {
      "id": "waec_bece_selected",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "BECE Result Checker purchase selected.",
        "action": "buy_waec_voucher",
        "voucherType": "BECE"
      }
    },
    {
      "id": "waec_wassce_selected",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "WASSCE and NOV DEC Result Checker purchase selected.",
        "action": "buy_waec_voucher",
        "voucherType": "WASSCE_NOV_DEC"
      }
    },
    {
      "id": "waec_bulk_notice",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "WAEC bulk purchase selected.",
        "action": "waec_bulk_purchase"
      }
    },
    {
      "id": "waec_affiliate_notice",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "WAEC Affiliate Reseller selected.",
        "action": "waec_affiliate_reseller"
      }
    },
    {
      "id": "waec_dashboard_notice",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Opening Wholesaler Dashboard.",
        "action": "waec_wholesaler_dashboard"
      }
    },
    {
      "id": "waec_merchant_name",
      "type": "action",
      "capability": "",
      "label": "Wholesaler full name",
      "await_input": true,
      "input_variable": "merchant_name",
      "prompt_config": {
        "message": "Enter your full name:\n0. Back",
        "interaction_type": "input",
        "input_validation": "input == '0' || len(input) >= 2",
        "timeout": "2m"
      },
      "next": "waec_check_merchant_name_back"
    },
    {
      "id": "waec_check_merchant_name_back",
      "type": "if",
      "condition": "merchant_name == '0'",
      "then": "waec_menu",
      "else": "waec_merchant_email"
    },
    {
      "id": "waec_merchant_email",
      "type": "action",
      "capability": "",
      "label": "Wholesaler email",
      "await_input": true,
      "input_variable": "merchant_email",
      "prompt_config": {
        "message": "Enter your email address:",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[^@ ]+@[^@ ]+[.][^@ ]+$')",
        "timeout": "2m"
      },
      "next": "waec_merchant_pin"
    },
    {
      "id": "waec_merchant_pin",
      "type": "action",
      "capability": "",
      "label": "Set wholesaler PIN",
      "await_input": true,
      "input_variable": "merchant_pin",
      "prompt_config": {
        "message": "Set a 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "waec_create_merchant"
    },
    {
      "id": "waec_create_merchant",
      "type": "command",
      "command": "http.post",
      "label": "Create WAEC merchant",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/waec/create-merchant",
        "headers": {
          "ClientId": "TDEXLviWgM",
          "ClientSecret": "58909b249a4649c49",
          "Content-Type": "application/json"
        },
        "body": {
          "merchantName": "$merchant_name",
          "phoneNumber": "${coalesce(phoneNo, msisdn)}",
          "email": "$merchant_email",
          "pin": "$merchant_pin"
        },
        "timeout": "15s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "waec_api_response": "$.body",
        "waec_api_message": "$.body.message"
      },
      "on_error": "waec_create_merchant_error",
      "next": "waec_create_merchant_result"
    },
    {
      "id": "waec_create_merchant_result",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(waec_api_message, \"Your WAEC Merchant registration request has been processed.\")}",
        "action": "waec_create_merchant"
      }
    },
    {
      "id": "waec_create_merchant_error",
      "type": "terminate",
      "status": "failure",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Unable to create your WAEC Merchant account. Please try again later.\")}",
        "action": "waec_create_merchant"
      }
    },
    {
      "id": "waec_recovery_transaction",
      "type": "action",
      "capability": "",
      "label": "Recover lost WAEC voucher",
      "await_input": true,
      "input_variable": "waec_transaction_id",
      "prompt_config": {
        "message": "Enter the transaction ID:\n0. Back",
        "interaction_type": "input",
        "input_validation": "matches(input, '^(0|[A-Za-z0-9-]{3,64})$')",
        "timeout": "2m"
      },
      "next": "waec_check_recovery_back"
    },
    {
      "id": "waec_check_recovery_back",
      "type": "if",
      "condition": "waec_transaction_id == '0'",
      "then": "waec_menu",
      "else": "waec_recover_voucher"
    },
    {
      "id": "waec_recover_voucher",
      "type": "command",
      "command": "http.post",
      "label": "Recover WAEC voucher",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/waec/recover-voucher",
        "headers": {
          "ClientId": "TDEXLviWgM",
          "ClientSecret": "58909b249a4649c49",
          "Content-Type": "application/json"
        },
        "body": {
          "phoneNumber": "${coalesce(phoneNo, msisdn)}",
          "transactionId": "$waec_transaction_id"
        },
        "timeout": "15s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "waec_api_response": "$.body",
        "waec_api_message": "$.body.message"
      },
      "on_error": "waec_recover_voucher_error",
      "next": "waec_recover_voucher_result"
    },
    {
      "id": "waec_recover_voucher_result",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(waec_api_message, \"Your voucher recovery request has been processed.\")}",
        "action": "waec_recover_voucher",
        "transactionId": "$waec_transaction_id"
      }
    },
    {
      "id": "waec_recover_voucher_error",
      "type": "terminate",
      "status": "failure",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Unable to recover your WAEC voucher. Check the transaction ID and try again.\")}",
        "action": "waec_recover_voucher",
        "transactionId": "$waec_transaction_id"
      }
    },
    {
      "id": "enterprise_menu",
      "type": "action",
      "capability": "",
      "label": "Enterprise",
      "await_input": true,
      "input_variable": "enterprise_choice",
      "prompt_config": {
        "message": "Enterprise\n1. Shortcode Express\n2. Business Desk 720 ERP\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_enterprise"
    },
    {
      "id": "route_enterprise",
      "type": "choice",
      "expression": "$enterprise_choice",
      "cases": {
        "1": "shortcode_menu",
        "2": "erp_menu",
        "0": "main_menu"
      },
      "default": "enterprise_menu"
    },
    {
      "id": "shortcode_menu",
      "type": "action",
      "capability": "",
      "label": "Shortcode Express",
      "await_input": true,
      "input_variable": "shortcode_choice",
      "prompt_config": {
        "message": "Shortcode Express\n1. Apply for Shortcode\n2. Renew Shortcode\n3. Buy Session Credits\n4. View Usage & Analytics\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_shortcode"
    },
    {
      "id": "route_shortcode",
      "type": "choice",
      "expression": "$shortcode_choice",
      "cases": {
        "1": "apply_shortcode",
        "2": "renew_shortcode",
        "3": "buy_credits",
        "4": "usage_analytics",
        "0": "enterprise_menu"
      },
      "default": "shortcode_menu"
    },
    {
      "id": "apply_shortcode",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Shortcode application started.",
        "action": "apply_shortcode"
      }
    },
    {
      "id": "renew_shortcode",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Shortcode renewal started.",
        "action": "renew_shortcode"
      }
    },
    {
      "id": "buy_credits",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Session credit purchase started.",
        "action": "buy_credits"
      }
    },
    {
      "id": "usage_analytics",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Usage and analytics request submitted.",
        "action": "usage_analytics"
      }
    },
    {
      "id": "erp_menu",
      "type": "action",
      "capability": "",
      "label": "Business Desk 720 ERP",
      "await_input": true,
      "input_variable": "erp_choice",
      "prompt_config": {
        "message": "Business Desk 720 ERP\n1. Register Business\n2. Renew Subscription\n3. View Subscription Details\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_erp"
    },
    {
      "id": "route_erp",
      "type": "choice",
      "expression": "$erp_choice",
      "cases": {
        "1": "register_business",
        "2": "renew_subscription",
        "3": "subscription_details",
        "0": "enterprise_menu"
      },
      "default": "erp_menu"
    },
    {
      "id": "register_business",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Business registration started.",
        "action": "register_business"
      }
    },
    {
      "id": "renew_subscription",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Subscription renewal started.",
        "action": "renew_subscription"
      }
    },
    {
      "id": "subscription_details",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Subscription details request submitted.",
        "action": "subscription_details"
      }
    },
    {
      "id": "tl_banking_menu",
      "type": "action",
      "capability": "",
      "label": "TL Banking",
      "await_input": true,
      "input_variable": "tl_choice",
      "prompt_config": {
        "message": "TL Banking\n1. Accounts & Enquiries\n2. Deposits & Withdrawals\n3. Loans & Credit\n4. Transfers & Payments\n5. Agents\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_tl"
    },
    {
      "id": "route_tl",
      "type": "choice",
      "expression": "$tl_choice",
      "cases": {
        "1": "accounts_menu",
        "2": "deposits_menu",
        "3": "loans_menu",
        "4": "transfers_menu",
        "5": "agents",
        "0": "main_menu"
      },
      "default": "tl_banking_menu"
    },
    {
      "id": "agents",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Agent services are currently unavailable.",
        "action": "agents"
      }
    },
    {
      "id": "accounts_menu",
      "type": "action",
      "capability": "",
      "label": "Accounts & Enquiries",
      "await_input": true,
      "input_variable": "accounts_choice",
      "prompt_config": {
        "message": "Accounts & Enquiries\n1. Open New Account\n2. Check Balance\n3. Mini Statement\n4. Full Statement\n5. Freeze / Unfreeze Account\n6. Link External Wallet (MoMo)\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_accounts"
    },
    {
      "id": "route_accounts",
      "type": "choice",
      "expression": "$accounts_choice",
      "cases": {
        "1": "account_type_menu",
        "2": "bank_balance",
        "3": "bank_mini",
        "4": "bank_full",
        "5": "freeze_account",
        "6": "link_wallet",
        "0": "tl_banking_menu"
      },
      "default": "accounts_menu"
    },
    {
      "id": "account_type_menu",
      "type": "action",
      "capability": "",
      "label": "Select Account Type",
      "await_input": true,
      "input_variable": "account_type",
      "prompt_config": {
        "message": "Select Account Type\n1. Susu\n2. Credit Union\n3. Savings & Loans\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_account_type"
    },
    {
      "id": "route_account_type",
      "type": "choice",
      "expression": "$account_type",
      "cases": {
        "1": "open_susu",
        "2": "open_credit_union",
        "3": "open_savings_loans",
        "0": "accounts_menu"
      },
      "default": "account_type_menu"
    },
    {
      "id": "open_susu",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Susu account application started.",
        "action": "open_susu"
      }
    },
    {
      "id": "open_credit_union",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Credit Union account application started.",
        "action": "open_credit_union"
      }
    },
    {
      "id": "open_savings_loans",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Savings & Loans account application started.",
        "action": "open_savings_loans"
      }
    },
    {
      "id": "bank_balance",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Balance enquiry submitted.",
        "action": "bank_balance"
      }
    },
    {
      "id": "bank_mini",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Mini statement requested.",
        "action": "bank_mini"
      }
    },
    {
      "id": "bank_full",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Full statement requested.",
        "action": "bank_full"
      }
    },
    {
      "id": "freeze_account",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Freeze / unfreeze request started.",
        "action": "freeze_account"
      }
    },
    {
      "id": "link_wallet",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "External wallet linking started.",
        "action": "link_wallet"
      }
    },
    {
      "id": "deposits_menu",
      "type": "action",
      "capability": "",
      "label": "Deposits & Withdrawals",
      "await_input": true,
      "input_variable": "deposit_choice",
      "prompt_config": {
        "message": "Deposits & Withdrawals\n1. Deposit to Account\n2. Withdraw from Account\n3. Agent Cash-In\n4. Agent Cash-Out\n5. Reverse Transaction\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_deposits"
    },
    {
      "id": "route_deposits",
      "type": "choice",
      "expression": "$deposit_choice",
      "cases": {
        "1": "deposit_account",
        "2": "withdraw_account",
        "3": "agent_cash_in",
        "4": "agent_cash_out",
        "5": "reverse_transaction",
        "0": "tl_banking_menu"
      },
      "default": "deposits_menu"
    },
    {
      "id": "deposit_account",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Deposit request started.",
        "action": "deposit_account"
      }
    },
    {
      "id": "withdraw_account",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Withdrawal request started.",
        "action": "withdraw_account"
      }
    },
    {
      "id": "agent_cash_in",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Agent cash-in started.",
        "action": "agent_cash_in"
      }
    },
    {
      "id": "agent_cash_out",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Agent cash-out started.",
        "action": "agent_cash_out"
      }
    },
    {
      "id": "reverse_transaction",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Transaction reversal request started.",
        "action": "reverse_transaction"
      }
    },
    {
      "id": "loans_menu",
      "type": "action",
      "capability": "",
      "label": "Loans & Credit",
      "await_input": true,
      "input_variable": "loan_choice",
      "prompt_config": {
        "message": "Loans & Credit\n1. Apply for Loan\n2. Repay Loan\n3. View Loan Schedule\n4. Default Tracking\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "route_loans"
    },
    {
      "id": "route_loans",
      "type": "choice",
      "expression": "$loan_choice",
      "cases": {
