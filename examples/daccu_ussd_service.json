      "input_variable": "new_pin",
      "prompt_config": {
        "message": "Enter New 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$') ",
        "timeout": "2m"
      },
      "next": "pin_confirm_new"
    },
    {
      "id": "pin_confirm_new",
      "type": "action",
      "capability": "",
      "label": "Confirm New PIN",
      "await_input": true,
      "input_variable": "confirm_pin",
      "prompt_config": {
        "message": "Confirm New 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$') ",
        "timeout": "2m"
      },
      "next": "check_pin_match"
    },
    {
      "id": "check_pin_match",
      "type": "if",
      "label": "Verify New PIN matches Confirmation",
