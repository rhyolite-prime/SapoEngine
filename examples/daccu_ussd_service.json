{
  "name": "examples.bank_ussd_service",
  "version": "1.0",
  "description": "USSD Banking Service built with Sapo DSL Engine, featuring multi-level menus for Deposit, Withdrawal, Funds Transfer, Enquiries, and Change PIN with live API integration and resilient error handling.",
  "defaults": {
    "bank_name": "Sapo Bank",
    "currency": "GHS",
    "phoneNo": "0242602262",
    "pinClientId": "dfdf",
    "pinClientSecret": "78877566456456",
    "clientId": "TDEXLvnWgM",
    "clientSecret": "49797884938483",
    "depositClientId": "TDEXLvnWgM",
    "depositClientSecret": "47809b129a3549c48",
    "pin": "7002",
    "provider": "mtn",
    "transactionType": "BankDeposit",
    "description": "Bank Deposit",
    "integrationChannel": "ussd-pos",
    "integratingService": "DACCU(*920*108#)",
    "momoClientId": "TDEXLvnWgM",
    "momoClientSecret": "47809b129a3549c48"
  },
  "nodes": [
    {
      "id": "main_menu",
      "type": "action",
      "capability": "",
      "label": "Bank USSD Main Menu",
      "await_input": true,
      "input_variable": "main_menu_choice",
      "prompt_config": {
        "message": "Welcome to Sapo Bank\n1. Deposit\n2. Withdrawal\n3. Funds transfer\n4. Enquiries\n5. Change PIN",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[1-5]$')",
        "timeout": "2m"
      },
      "next": "route_main_menu"
    },
    {
      "id": "route_main_menu",
      "type": "choice",
      "label": "Route Main Menu selection",
      "expression": "$main_menu_choice",
      "cases": {
        "1": "menu_deposit",
        "2": "menu_withdrawal",
        "3": "menu_funds_transfer",
        "4": "menu_enquiries",
        "5": "menu_change_pin"
      },
      "default": "main_menu"
    },
    {
      "id": "menu_deposit",
      "type": "action",
      "capability": "",
      "label": "Deposit Account Selection Menu",
      "await_input": true,
      "input_variable": "deposit_choice",
      "prompt_config": {
        "message": "Deposit\n1. Flexy Account\n2. Kiddy Account\n3. Savings Account\n4. Shares Deposit Account\n5. Loan Account\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-5]$')",
        "timeout": "2m"
      },
      "next": "route_deposit"
    },
    {
      "id": "route_deposit",
      "type": "choice",
      "label": "Route Deposit selection",
      "expression": "$deposit_choice",
      "cases": {
        "0": "main_menu",
        "1": "select_deposit_flexy",
        "2": "select_deposit_kiddy",
        "3": "select_deposit_savings",
        "4": "select_deposit_shares",
        "5": "select_deposit_loan"
      },
      "default": "menu_deposit"
    },
    {
      "id": "select_deposit_flexy",
      "type": "noop",
      "assign": {
        "target_account": "Flexy Account",
        "account_code": "F"
      },
      "next": "deposit_prompt_amount"
    },
    {
      "id": "select_deposit_kiddy",
      "type": "noop",
      "assign": {
        "target_account": "Kiddy Account",
        "account_code": "K"
      },
      "next": "deposit_prompt_amount"
    },
    {
      "id": "select_deposit_savings",
      "type": "noop",
      "assign": {
        "target_account": "Savings Account",
        "account_code": "U"
      },
      "next": "deposit_prompt_amount"
    },
    {
      "id": "select_deposit_shares",
      "type": "noop",
      "assign": {
        "target_account": "Shares Deposit Account",
        "account_code": "S"
      },
      "next": "deposit_prompt_amount"
    },
    {
      "id": "select_deposit_loan",
      "type": "noop",
      "assign": {
        "target_account": "Loan Account",
        "account_code": "L"
      },
      "next": "deposit_prompt_amount"
    },
    {
      "id": "deposit_prompt_amount",
      "type": "action",
      "capability": "",
      "label": "Prompt for deposit amount",
      "await_input": true,
      "input_variable": "deposit_amount",
      "prompt_config": {
        "message": "Enter Amount to deposit into ${target_account} (GHS):",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]+(\\.[0-9]{1,2})?$')",
        "timeout": "2m"
      },
      "next": "call_deposit_api"
    },
    {
      "id": "call_deposit_api",
      "type": "command",
      "command": "http.post",
      "label": "Initialize Deposit via USSD API",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/smart-suite/initialize-deposit-via-ussd",
        "headers": {
          "ClientId": "${coalesce(depositClientId, clientId, \"TDEXLvnWgM\")}",
          "ClientSecret": "${coalesce(depositClientSecret, \"47809b129a3549c48\")}",
          "Content-Type": "application/json"
        },
        "body": {
          "customerName": "${coalesce(customerName, if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"+\"), substring(coalesce(phoneNo, msisdn, \"\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"\"), 1), coalesce(phoneNo, msisdn, \"233242602262\"))))}",
          "customerMsisdn": "${coalesce(customerMsisdn, if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"+\"), substring(coalesce(phoneNo, msisdn, \"\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"\"), 1), coalesce(phoneNo, msisdn, \"233242602262\"))))}",
          "customerEmail": "${coalesce(customerEmail, if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"+\"), substring(coalesce(phoneNo, msisdn, \"\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"\"), 1), coalesce(phoneNo, msisdn, \"233242602262\"))) + \"@rhyoliteprime.com\")}",
          "amount": "${to_number(deposit_amount)}",
          "description": "Bank Deposit",
          "provider": "${coalesce(network, provider, \"mtn\")}",
          "transactionType": "BankDeposit",
          "accountType": "$account_code",
          "integrationChannel": "ussd-pos",
          "integratingService": "DACCU(*920*108#)",
          "kiddyAccountSerialNo": "${coalesce(kiddyAccountSerialNo, \"\")}",
          "pin": "${coalesce(user_pin, pin, \"7002\")}"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "api_response": "$.body",
        "api_status": "$.status",
        "deposit_message": "$.body.message"
      },
      "on_error": "deposit_api_transport_error",
      "next": "check_deposit_response"
    },
    {
      "id": "check_deposit_response",
      "type": "if",
      "label": "Check Deposit API Response",
      "condition": "api_response != null && api_response.success == true",
      "then": "deposit_success",
      "else": "deposit_api_rejection"
    },
    {
      "id": "deposit_success",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(deposit_message, api_response.message, \"Authorize Payment by entering PIN on your mobile device. If no bill prompt appears, dial *170# to resume.\")}",
        "success": true,
        "action": "deposit",
        "account": "$target_account",
        "account_code": "$account_code",
        "amount": "${to_number(deposit_amount)}"
      }
    },
    {
      "id": "deposit_api_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(api_response.message, \"Failed to initialize deposit. Please try again.\")}",
        "success": false,
        "action": "deposit",
        "code": "${coalesce(api_response.code, 1)}"
      }
    },
    {
      "id": "deposit_api_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, our deposit service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "deposit",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "menu_withdrawal",
      "type": "action",
      "capability": "",
      "label": "Withdrawal Menu",
      "await_input": true,
      "input_variable": "withdrawal_choice",
      "prompt_config": {
        "message": "Withdrawal\n1. Flexy to Momo\n2. Flexy to Bank\n3. Savings Withdrawl Request\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-3]$')",
        "timeout": "2m"
      },
      "next": "route_withdrawal"
    },
    {
      "id": "route_withdrawal",
      "type": "choice",
      "label": "Route Withdrawal selection",
      "expression": "$withdrawal_choice",
      "cases": {
        "0": "main_menu",
        "1": "menu_momo_target",
        "2": "wd_bank_select",
        "3": "menu_savings_request"
      },
      "default": "menu_withdrawal"
    },
    {
      "id": "menu_momo_target",
      "type": "action",
      "capability": "",
      "label": "Flexy to Momo Recipient Type",
      "await_input": true,
      "input_variable": "momo_target_choice",
      "prompt_config": {
        "message": "Flexy to Momo\n1. Self\n2. Others\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-2]$')",
        "timeout": "2m"
      },
      "next": "route_momo_target"
    },
    {
      "id": "route_momo_target",
      "type": "choice",
      "label": "Route Self vs Others",
      "expression": "$momo_target_choice",
      "cases": {
        "0": "menu_withdrawal",
        "1": "set_momo_self",
        "2": "prompt_momo_other_number"
      },
      "default": "menu_momo_target"
    },
    {
      "id": "set_momo_self",
      "type": "noop",
      "label": "Set Self Recipient Number",
      "assign": {
        "recipient_type": "self",
        "recipient_msisdn": "${coalesce(phoneNo, msisdn, \"0242602262\")}"
      },
      "next": "menu_momo_network"
    },
    {
      "id": "prompt_momo_other_number",
      "type": "action",
      "capability": "",
      "label": "Enter Recipient Mobile Number",
      "await_input": true,
      "input_variable": "recipient_msisdn",
      "prompt_config": {
        "message": "Enter Recipient Momo Number:\n0. Back",
        "interaction_type": "input",
        "input_validation": "matches(input, '^(0|0[0-9]{9}|233[0-9]{9})$')",
        "timeout": "2m"
      },
      "next": "check_other_number_back"
    },
    {
      "id": "check_other_number_back",
      "type": "if",
      "label": "Check if User entered 0 to go Back",
      "condition": "recipient_msisdn == '0'",
      "then": "menu_momo_target",
      "else": "menu_momo_network"
    },
    {
      "id": "menu_momo_network",
      "type": "action",
      "capability": "",
      "label": "Select Mobile Money Network",
      "await_input": true,
      "input_variable": "momo_network_choice",
      "prompt_config": {
        "message": "Select Network:\n1. MTN\n2. TELECEL\n3. AIRTELTIGO\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-3]$')",
        "timeout": "2m"
      },
      "next": "route_momo_network"
    },
    {
      "id": "route_momo_network",
      "type": "choice",
      "label": "Route Mobile Money Network",
      "expression": "$momo_network_choice",
      "cases": {
        "0": "menu_momo_target",
        "1": "set_network_mtn",
        "2": "set_network_telecel",
        "3": "set_network_airteltigo"
      },
      "default": "menu_momo_network"
    },
    {
      "id": "set_network_mtn",
      "type": "noop",
      "assign": {
        "provider": "mtn",
        "network_name": "MTN"
      },
      "next": "prompt_momo_amount"
    },
    {
      "id": "set_network_telecel",
      "type": "noop",
      "assign": {
        "provider": "telecel",
        "network_name": "TELECEL"
      },
      "next": "prompt_momo_amount"
    },
    {
      "id": "set_network_airteltigo",
      "type": "noop",
      "assign": {
        "provider": "airteltigo",
        "network_name": "AIRTELTIGO"
      },
      "next": "prompt_momo_amount"
    },
    {
      "id": "prompt_momo_amount",
      "type": "action",
      "capability": "",
      "label": "Enter Withdrawal Amount",
      "await_input": true,
      "input_variable": "withdraw_amount",
      "prompt_config": {
        "message": "Enter Amount to withdraw (GHS):",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]+(\\.[0-9]{1,2})?$')",
        "timeout": "2m"
      },
      "next": "prompt_momo_pin"
    },
    {
      "id": "prompt_momo_pin",
      "type": "action",
      "capability": "",
      "label": "Enter 4-digit PIN to Authorize Withdrawal",
      "await_input": true,
      "input_variable": "user_pin",
      "prompt_config": {
        "message": "Enter 4-digit PIN to authorize withdrawal of GHS ${withdraw_amount} to ${network_name} (${recipient_msisdn}):",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "call_flexy_to_momo_api"
    },
    {
      "id": "call_flexy_to_momo_api",
      "type": "command",
      "command": "http.post",
      "label": "Call Initialize Flexy Withdrawal to Momo API",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/smart-suite/initialize-flexy-withdrawal-to-momo",
        "headers": {
          "ClientId": "${coalesce(momoClientId, clientId, \"TDEXLvnWgM\")}",
          "ClientSecret": "${coalesce(momoClientSecret, \"47809b129a3549c48\")}",
          "Content-Type": "application/json"
        },
        "body": {
          "recipientName": "${coalesce(recipientName, \"N/A\")}",
          "amount": "${to_number(withdraw_amount)}",
          "recipientMsisdn": "${coalesce(recipient_msisdn, phoneNo, msisdn, \"0242602262\")}",
          "senderMsisdn": "${coalesce(senderMsisdn, if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"0\"), \"+233\" + substring(coalesce(phoneNo, msisdn, \"\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"+\"), coalesce(phoneNo, msisdn, \"\"), \"+233\" + coalesce(phoneNo, msisdn, \"244256444\"))))}",
          "customerEmail": "${coalesce(customerEmail, if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"+\"), substring(coalesce(phoneNo, msisdn, \"\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"\"), 1), coalesce(phoneNo, msisdn, \"233244256444\"))) + \"@rhyoliteprime.com\")}",
          "provider": "$provider",
          "description": "Withdrawl(Momo)",
          "accountType": "F",
          "integrationChannel": "ussd-pos",
          "integratingService": "*920*108#",
          "kiddyAccountSerialNo": "",
          "pin": "$user_pin"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "api_response": "$.body",
        "api_status": "$.status",
        "momo_message": "$.body.message"
      },
      "on_error": "wd_momo_api_transport_error",
      "next": "check_momo_response"
    },
    {
      "id": "check_momo_response",
      "type": "if",
      "label": "Check Momo Withdrawal Response",
      "condition": "api_response != null && api_response.success == true",
      "then": "wd_momo_success",
      "else": "wd_momo_api_rejection"
    },
    {
      "id": "wd_momo_success",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(momo_message, api_response.message, \"Withdrawal initiated successfully.\")}",
        "success": true,
        "action": "withdrawal_momo",
        "amount": "${to_number(withdraw_amount)}",
        "recipient": "$recipient_msisdn",
        "provider": "$provider"
      }
    },
    {
      "id": "wd_momo_api_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(api_response.message, \"Failed to initiate withdrawal. Please try again later.\")}",
        "success": false,
        "action": "withdrawal_momo",
        "code": "${coalesce(api_response.code, 1)}"
      }
    },
    {
      "id": "wd_momo_api_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, our mobile money withdrawal service is temporarily unavailable. Please try again later.\")}",
        "success": false,
        "action": "withdrawal_momo",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "wd_bank_select",
      "type": "action",
      "capability": "",
      "label": "Select Destination Bank",
      "await_input": true,
      "input_variable": "bank_code",
      "prompt_config": {
        "message": "Select Destination Bank:\n1. GCB Bank\n2. Ecobank\n3. Stanbic Bank\n4. Fidelity Bank\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-4]$')",
        "timeout": "2m"
      },
      "next": "route_bank_select"
    },
    {
      "id": "route_bank_select",
      "type": "choice",
      "expression": "$bank_code",
      "cases": {
        "0": "menu_withdrawal",
        "1": "set_bank_gcb",
        "2": "set_bank_ecobank",
        "3": "set_bank_stanbic",
        "4": "set_bank_fidelity"
      },
      "default": "wd_bank_select"
    },
    {
      "id": "set_bank_gcb",
      "type": "noop",
      "assign": {
        "bank_name": "GCB Bank"
      },
      "next": "wd_bank_account"
    },
    {
      "id": "set_bank_ecobank",
      "type": "noop",
      "assign": {
        "bank_name": "Ecobank"
      },
      "next": "wd_bank_account"
    },
    {
      "id": "set_bank_stanbic",
      "type": "noop",
      "assign": {
        "bank_name": "Stanbic Bank"
      },
      "next": "wd_bank_account"
    },
    {
      "id": "set_bank_fidelity",
      "type": "noop",
      "assign": {
        "bank_name": "Fidelity Bank"
      },
      "next": "wd_bank_account"
    },
    {
      "id": "wd_bank_account",
      "type": "action",
      "capability": "",
      "label": "Enter Bank Account Number",
      "await_input": true,
      "input_variable": "bank_account",
      "prompt_config": {
        "message": "Enter ${bank_name} Account Number:",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]{8,16}$') ",
        "timeout": "2m"
      },
      "next": "wd_bank_amount"
    },
    {
      "id": "wd_bank_amount",
      "type": "action",
      "capability": "",
      "label": "Enter Bank Transfer Amount",
      "await_input": true,
      "input_variable": "withdraw_amount",
      "prompt_config": {
        "message": "Enter Amount to transfer to ${bank_name} (GHS):",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]+(\\.[0-9]{1,2})?$')",
        "timeout": "2m"
      },
      "next": "wd_bank_pin"
    },
    {
      "id": "wd_bank_pin",
      "type": "action",
      "capability": "",
      "label": "Authorize Bank Transfer",
      "await_input": true,
      "input_variable": "user_pin",
      "prompt_config": {
        "message": "Enter 4-digit PIN to authorize transfer of GHS ${withdraw_amount} to ${bank_name} (${bank_account}):",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$') ",
        "timeout": "2m"
      },
      "next": "wd_bank_success"
    },
    {
      "id": "wd_bank_success",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Transfer of GHS ${withdraw_amount} to ${bank_name} Account ${bank_account} submitted. Ref: BNK-${now('ms')}",
        "action": "withdrawal_bank",
        "bank": "$bank_name",
        "account": "$bank_account",
        "amount": "$withdraw_amount"
      }
    },
    {
      "id": "wd_savings_amount",
      "type": "action",
      "capability": "",
      "label": "Savings Withdrawal Request Amount",
      "await_input": true,
      "input_variable": "savings_amount",
      "prompt_config": {
        "message": "Enter Savings Withdrawal Amount (GHS):",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]+(\\.[0-9]{1,2})?$')",
        "timeout": "2m"
      },
      "next": "wd_savings_reason"
    },
    {
      "id": "wd_savings_reason",
      "type": "action",
      "capability": "",
      "label": "Savings Withdrawal Reason",
      "await_input": true,
      "input_variable": "savings_reason_code",
      "prompt_config": {
        "message": "Select Reason for Withdrawal:\n1. Emergency\n2. Medical\n3. School Fees\n4. Business\n5. Other",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[1-5]$')",
        "timeout": "2m"
      },
      "next": "wd_savings_pin"
    },
    {
      "id": "wd_savings_pin",
      "type": "action",
      "capability": "",
      "label": "Authorize Savings Withdrawal Request",
      "await_input": true,
      "input_variable": "user_pin",
      "prompt_config": {
        "message": "Enter 4-digit PIN to submit Savings Withdrawal Request for GHS ${savings_amount}:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$') ",
        "timeout": "2m"
      },
      "next": "wd_savings_success"
    },
    {
