      }
    },
    {
      "id": "menu_enquiries",
      "type": "action",
      "capability": "",
      "label": "Enquiries Menu",
      "await_input": true,
      "input_variable": "enquiry_choice",
      "prompt_config": {
        "message": "Enquiries\n1. Balances\n2. Mini Statement\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-2]$')",
        "timeout": "2m"
      },
      "next": "route_enquiries"
    },
    {
      "id": "route_enquiries",
      "type": "choice",
      "label": "Route Enquiries selection",
      "expression": "$enquiry_choice",
      "cases": {
        "0": "main_menu",
        "1": "prep_enquiry_balance",
        "2": "prep_enquiry_ministatement"
      },
      "default": "menu_enquiries"
    },
    {
      "id": "prep_enquiry_balance",
      "type": "noop",
      "assign": {
        "enquiry_type": "balance",
        "enquiry_title": "Balances"
      },
      "next": "menu_enquiry_accounts"
    },
    {
      "id": "prep_enquiry_ministatement",
      "type": "noop",
      "assign": {
        "enquiry_type": "ministatement",
        "enquiry_title": "Mini Statement"
      },
      "next": "menu_enquiry_accounts"
    },
    {
      "id": "menu_enquiry_accounts",
      "type": "action",
      "capability": "",
      "label": "Select Account for Enquiry",
      "await_input": true,
      "input_variable": "account_selection",
      "prompt_config": {
        "message": "${enquiry_title}\nSelect Account:\n1. Flexy Account\n2. Kiddy Account\n3. Savings Account\n4. Shares Account\n5. Loan Account\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-5]$')",
        "timeout": "2m"
      },
      "next": "route_enquiry_accounts"
    },
    {
      "id": "route_enquiry_accounts",
      "type": "choice",
      "label": "Route Account selection and assign code",
      "expression": "$account_selection",
      "cases": {
        "0": "menu_enquiries",
        "1": "set_enquiry_flexy",
        "2": "set_enquiry_kiddy",
        "3": "set_enquiry_savings",
        "4": "set_enquiry_shares",
        "5": "set_enquiry_loan"
      },
      "default": "menu_enquiry_accounts"
    },
    {
      "id": "set_enquiry_flexy",
      "type": "noop",
      "assign": {
        "account_code": "F",
        "account_name": "Flexy Account"
      },
      "next": "prompt_enquiry_pin"
    },
    {
      "id": "set_enquiry_kiddy",
      "type": "noop",
      "assign": {
        "account_code": "K",
        "account_name": "Kiddy Account"
      },
      "next": "prompt_enquiry_pin"
    },
    {
      "id": "set_enquiry_savings",
      "type": "noop",
      "assign": {
        "account_code": "U",
        "account_name": "Savings Deposit Account"
      },
      "next": "prompt_enquiry_pin"
    },
    {
      "id": "set_enquiry_shares",
      "type": "noop",
      "assign": {
        "account_code": "S",
        "account_name": "Shares Account"
      },
      "next": "prompt_enquiry_pin"
    },
    {
      "id": "set_enquiry_loan",
      "type": "noop",
      "assign": {
        "account_code": "L",
        "account_name": "Loan Account"
      },
      "next": "prompt_enquiry_pin"
    },
    {
      "id": "prompt_enquiry_pin",
      "type": "action",
      "capability": "",
      "label": "Prompt for 4-digit PIN",
      "await_input": true,
      "input_variable": "user_pin",
      "prompt_config": {
        "message": "Enter 4-digit PIN for ${account_name}:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$') ",
        "timeout": "2m"
      },
      "next": "route_enquiry_dispatch"
    },
    {
      "id": "route_enquiry_dispatch",
      "type": "choice",
      "label": "Dispatch to Balance or Mini Statement API",
      "expression": "$enquiry_type",
      "cases": {
        "balance": "call_balance_api",
        "ministatement": "call_mini_statement_api"
      },
      "default": "call_balance_api"
    },
    {
      "id": "call_balance_api",
      "type": "command",
      "command": "http.post",
      "label": "Fetch Account Balance API",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/smart-suite/get-account-balance",
        "headers": {
          "ClientId": "$clientId",
          "ClientSecret": "$clientSecret",
          "Content-Type": "application/json"
        },
        "body": {
          "phoneNo": "${coalesce(phoneNo, msisdn)}",
          "pin": "${user_pin}",
          "accountType": "${account_code}"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "api_response": "$.body",
        "api_status": "$.status",
        "balance_message": "$.body.message"
      },
      "on_error": "enquiry_api_transport_error",
      "next": "check_api_response"
    },
    {
      "id": "call_mini_statement_api",
      "type": "command",
      "command": "http.post",
      "label": "Fetch Mini Statement API",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/smart-suite/get-mini-statement",
        "headers": {
          "ClientId": "$clientId",
          "ClientSecret": "$clientSecret",
          "Content-Type": "application/json"
        },
        "body": {
          "phoneNo": "${coalesce(phoneNo, msisdn)}",
          "pin": "${user_pin}",
          "accountType": "${account_code}",
          "serialNo": ""
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "api_response": "$.body",
        "api_status": "$.status",
        "statement_message": "$.body.message"
      },
      "on_error": "enquiry_api_transport_error",
      "next": "check_api_response"
    },
    {
      "id": "check_api_response",
      "type": "if",
      "label": "Check if API returned success",
      "condition": "api_response != null && api_response.success == true",
      "then": "enquiry_display_success",
      "else": "enquiry_display_api_rejection"
    },
    {
      "id": "enquiry_display_success",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${api_response.message}",
        "balance": "${coalesce(balance_message, api_response.message)}",
        "success": true,
        "action": "enquiry",
        "account": "$account_name",
        "account_code": "$account_code",
        "enquiry_type": "$enquiry_type"
      }
    },
    {
      "id": "enquiry_display_api_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(api_response.message, 'Dear customer, your request could not be completed. Please check your PIN and try again.')}",
        "success": false,
        "action": "enquiry",
        "code": "${coalesce(api_response.code, 1)}"
      }
    },
    {
      "id": "enquiry_api_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, our banking enquiry service is temporarily unavailable. Please try again in a few moments or contact support.\")}",
        "success": false,
        "action": "enquiry",
        "error_code": "${coalesce(error.code, 'HTTP_ERROR')}",
        "error_detail": "${coalesce(error.message, 'Network unreachable')}",
        "response_body": "$error.data.body",
        "request_url": "$error.data.url"
      },
      "message": "Dear customer, our banking enquiry service is temporarily unavailable. Please try again in a few moments or contact support."
    },
    {
      "id": "menu_change_pin",
      "type": "action",
      "capability": "",
      "label": "Enter Current PIN",
      "await_input": true,
      "input_variable": "current_pin",
      "prompt_config": {
        "message": "Change PIN\nEnter Current 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "pin_enter_new"
    },
    {
      "id": "pin_enter_new",
      "type": "action",
      "capability": "",
      "label": "Enter New PIN",
      "await_input": true,
      "input_variable": "new_pin",
      "prompt_config": {
        "message": "Enter New 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "pin_confirm_message"
    },
    {
      "id": "pin_confirm_message",
      "type": "action",
      "capability": "",
      "label": "Present PIN Confirmation Message",
      "await_input": true,
      "input_variable": "pin_confirm_code",
      "prompt_config": {
        "message": "You are about to change your PIN, Enter 77 to confirm",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]+$')",
        "timeout": "2m"
      },
      "next": "check_pin_confirm_code"
    },
    {
      "id": "check_pin_confirm_code",
      "type": "if",
      "label": "Verify Confirmation Code 77",
      "condition": "pin_confirm_code == '77' || pin_confirm_code == 77",
      "then": "call_change_pin_api",
      "else": "pin_change_cancelled"
    },
    {
      "id": "call_change_pin_api",
      "type": "command",
      "command": "http.post",
      "label": "Execute Change PIN API",
      "http_request": {
        "url": "https://ultra-magnus.rhyoliteprime.com/api/v1/third-party/smart-suite/change-pin",
        "headers": {
          "ClientId": "$clientId",
          "ClientSecret": "$clientSecret",
          "Content-Type": "application/json"
        },
        "body": {
          "phoneNo": "${coalesce(phoneNo, msisdn)}",
          "currentPin": "${current_pin}",
          "newPin": "${new_pin}"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "api_response": "$.body",
        "api_status": "$.status",
        "api_message": "$.body.message"
      },
      "on_error": "pin_change_api_transport_error",
      "next": "check_change_pin_response"
    },
    {
      "id": "check_change_pin_response",
      "type": "if",
      "label": "Check Change PIN Response Status",
      "condition": "api_response != null && api_response.success == true",
      "then": "pin_change_success",
      "else": "pin_change_api_rejection"
    },
    {
      "id": "pin_change_success",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(api_response.message, \"PIN changed successfully.\")}",
        "success": true,
        "action": "change_pin",
        "status": "pin_changed"
      }
    },
    {
      "id": "pin_change_api_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(api_response.message, \"Failed to change PIN. Please try again.\")}",
        "success": false,
        "action": "change_pin",
        "code": "${coalesce(api_response.code, 1)}"
      }
    },
    {
      "id": "pin_change_api_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, our PIN change service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "change_pin",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "pin_change_cancelled",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "PIN change was not confirmed. Your PIN remains unchanged.",
        "action": "change_pin",
        "status": "cancelled"
      }
    },
    {
      "id": "operation_cancelled",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Operation cancelled. Thank you for banking with Sapo Bank.",
        "action": "cancelled"
      }
    }
  ]
}
