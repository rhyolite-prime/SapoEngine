      }
    },
    {
      "id": "ft_member_account",
      "type": "action",
      "capability": "",
      "label": "Enter Member Account / ID",
      "await_input": true,
      "input_variable": "member_account",
      "prompt_config": {
        "message": "Enter Member Account Number / Member ID:",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]{6,12}$') ",
        "timeout": "2m"
      },
      "next": "ft_member_amount"
    },
    {
      "id": "ft_member_amount",
      "type": "action",
      "capability": "",
      "label": "Enter Amount to Transfer to Member",
      "await_input": true,
      "input_variable": "transfer_amount",
      "prompt_config": {
        "message": "Enter Amount to transfer (GHS):",
        "interaction_type": "input",
        "input_validation": "matches(input, '^[0-9]+(\\.[0-9]{1,2})?$')",
        "timeout": "2m"
      },
      "next": "ft_member_pin"
    },
    {
      "id": "ft_member_pin",
      "type": "action",
      "capability": "",
      "label": "Authorize Member Transfer",
      "await_input": true,
      "input_variable": "user_pin",
      "prompt_config": {
        "message": "Enter 4-digit PIN to transfer GHS ${transfer_amount} to Member Account ${member_account}:",
        "interaction_type": "pin",
