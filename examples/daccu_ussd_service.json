        "action": "change_pin",
        "status": "pin_mismatch"
      }
    },
    {
      "id": "operation_cancelled",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Operation cancelled. Thank you for banking with Sapo Bank.",
        "action": "cancelled"
      }
