{
  "name": "examples.chop_money_raffle_ussd_service",
  "version": "1.0",
  "description": "Chop Money Raffle USSD Service built with Sapo DSL Engine: buy raffle tickets (active raffles -> raffle option -> ticket group -> mobile money payment), view my tickets with raffle stats, weekly upcoming raffles with raffle stats, account PIN services (get/reset/change) and help & support contact info.",
  "defaults": {
    "service_name": "Chop Money Raffle",
    "phoneNo": "0242602262",
    "provider": "mtn",
    "paymentMethod": "Mobile Money",
    "purchaseChannel": "USSD"
  },
  "nodes": [
    {
      "id": "main_menu",
      "type": "action",
      "capability": "",
      "label": "Chop Money Raffle Main Menu",
      "await_input": true,
      "input_variable": "main_menu_choice",
      "prompt_config": {
        "message": "Welcome to Chop Money Raffle\n1. Buy Tickets\n2. My Tickets\n3. Upcoming Raffles\n4. Account\n5. Help and Support",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[1-5]$')",
        "timeout": "2m"
      },
      "next": "route_main_menu"
    },
    {
      "id": "route_main_menu",
      "type": "choice",
      "label": "Route Main Menu selection",
      "expression": "$main_menu_choice",
      "cases": {
        "1": "call_active_raffles",
        "2": "my_tickets",
        "3": "call_weekly_raffles",
        "4": "set_account_context",
        "5": "help_support"
      },
      "default": "main_menu"
    },
    {
      "id": "call_active_raffles",
      "type": "command",
      "command": "http.get",
      "label": "Fetch Active Raffles API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/raffle/get-active-raffles",
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "raffles_response": "$.body",
        "raffle_list": "$.body.result.data"
      },
      "on_error": "raffles_transport_error",
      "next": "check_raffles_response"
    },
    {
      "id": "check_raffles_response",
      "type": "if",
      "label": "Check Active Raffles API Response",
      "condition": "raffles_response != null && raffles_response.success == true",
      "then": "check_raffles_empty",
      "else": "raffles_rejection"
    },
    {
      "id": "check_raffles_empty",
      "type": "if",
      "label": "Check if any Active Raffles were returned",
      "condition": "is_array(raffle_list) && len(raffle_list) > 0",
      "then": "menu_raffles",
      "else": "raffles_none"
    },
    {
      "id": "menu_raffles",
      "type": "action",
      "capability": "",
      "label": "Active Raffle Selection Menu",
      "await_input": true,
      "input_variable": "raffle_choice",
      "prompt_config": {
        "message": "${'Buy Tickets\nSelect Raffle:\n' + join(map(raffle_list, (index + 1) + '. ' + item.name), '\n') + '\n0. Back'}",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]$')",
        "timeout": "2m"
      },
      "next": "check_raffles_back"
    },
    {
      "id": "check_raffles_back",
      "type": "if",
      "label": "Check if User entered 0 to go Back",
      "condition": "raffle_choice == '0' || raffle_choice == 0",
      "then": "main_menu",
      "else": "check_raffles_range"
    },
    {
      "id": "check_raffles_range",
      "type": "if",
      "label": "Validate selected raffle number",
      "condition": "to_number(raffle_choice) >= 1 && to_number(raffle_choice) <= len(raffle_list)",
      "then": "set_selected_raffle",
      "else": "menu_raffles"
    },
    {
      "id": "set_selected_raffle",
      "type": "noop",
      "label": "Record Selected Raffle",
      "assign": {
        "raffle_id": "${get(raffle_list, '[' + to_string(to_number(raffle_choice) - 1) + ']', null).id}",
        "raffle_name": "${get(raffle_list, '[' + to_string(to_number(raffle_choice) - 1) + ']', null).name}"
      },
      "next": "call_raffle_options"
    },
    {
      "id": "call_raffle_options",
      "type": "command",
      "command": "http.get",
      "label": "Fetch Raffle Options API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/raffle/get-active-raffle-options",
        "query": {
          "raffleId": "$raffle_id"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "options_response": "$.body",
        "option_list": "$.body.result.data"
      },
      "on_error": "options_transport_error",
      "next": "check_options_response"
    },
    {
      "id": "check_options_response",
      "type": "if",
      "label": "Check Raffle Options API Response",
      "condition": "options_response != null && options_response.success == true",
      "then": "check_options_empty",
      "else": "options_rejection"
    },
    {
      "id": "check_options_empty",
      "type": "if",
      "label": "Check if any Raffle Options were returned",
      "condition": "is_array(option_list) && len(option_list) > 0",
      "then": "menu_options",
      "else": "options_none"
    },
    {
      "id": "menu_options",
      "type": "action",
      "capability": "",
      "label": "Raffle Option Selection Menu",
      "await_input": true,
      "input_variable": "option_choice",
      "prompt_config": {
        "message": "${'Select Option for ' + raffle_name + ':\n' + join(map(option_list, (index + 1) + '. ' + item.name), '\n') + '\n0. Back'}",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]$')",
        "timeout": "2m"
      },
      "next": "check_options_back"
    },
    {
      "id": "check_options_back",
      "type": "if",
      "label": "Check if User entered 0 to go Back",
      "condition": "option_choice == '0' || option_choice == 0",
      "then": "menu_raffles",
      "else": "check_options_range"
    },
    {
      "id": "check_options_range",
      "type": "if",
      "label": "Validate selected option number",
      "condition": "to_number(option_choice) >= 1 && to_number(option_choice) <= len(option_list)",
      "then": "set_selected_option",
      "else": "menu_options"
    },
    {
      "id": "set_selected_option",
      "type": "noop",
      "label": "Record Selected Raffle Option",
      "assign": {
        "selected_option_id": "${get(option_list, '[' + to_string(to_number(option_choice) - 1) + ']', null).id}",
        "selected_option_name": "${get(option_list, '[' + to_string(to_number(option_choice) - 1) + ']', null).name}"
      },
      "next": "call_ticket_groups"
    },
    {
      "id": "call_ticket_groups",
      "type": "command",
      "command": "http.get",
      "label": "Fetch Ticket Groups API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/cms/tickets/get-groups",
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "groups_response": "$.body",
        "group_list": "$.body.result.data"
      },
      "on_error": "groups_transport_error",
      "next": "check_groups_response"
    },
    {
      "id": "check_groups_response",
      "type": "if",
      "label": "Check Ticket Groups API Response",
      "condition": "groups_response != null && groups_response.success == true",
      "then": "check_groups_empty",
      "else": "groups_rejection"
    },
    {
      "id": "check_groups_empty",
      "type": "if",
      "label": "Check if any Ticket Groups were returned",
      "condition": "is_array(group_list) && len(group_list) > 0",
      "then": "menu_groups",
      "else": "groups_none"
    },
    {
      "id": "menu_groups",
      "type": "action",
      "capability": "",
      "label": "Ticket Group Selection Menu",
      "await_input": true,
      "input_variable": "group_choice",
      "prompt_config": {
        "message": "${'Select Tickets:\n' + join(map(group_list, (index + 1) + '. ' + item.name), '\n') + '\n0. Back'}",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]$')",
        "timeout": "2m"
      },
      "next": "check_groups_back"
    },
    {
      "id": "check_groups_back",
      "type": "if",
      "label": "Check if User entered 0 to go Back",
      "condition": "group_choice == '0' || group_choice == 0",
      "then": "menu_options",
      "else": "check_groups_range"
    },
    {
      "id": "check_groups_range",
      "type": "if",
      "label": "Validate selected ticket group number",
      "condition": "to_number(group_choice) >= 1 && to_number(group_choice) <= len(group_list)",
      "then": "set_selected_group",
      "else": "menu_groups"
    },
    {
      "id": "set_selected_group",
      "type": "noop",
      "label": "Record Selected Ticket Group and Prepare Purchase Context",
      "assign": {
        "ticket_group_id": "${get(group_list, '[' + to_string(to_number(group_choice) - 1) + ']', null).id}",
        "ticket_group_name": "${get(group_list, '[' + to_string(to_number(group_choice) - 1) + ']', null).name}",
        "ticket_quantity": "${get(group_list, '[' + to_string(to_number(group_choice) - 1) + ']', null).quantity}",
        "customer_phone": "${if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"+233\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 4), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"233\") && len(coalesce(phoneNo, msisdn, \"0242602262\")) == 12, coalesce(phoneNo, msisdn, \"0242602262\"), if(len(coalesce(phoneNo, msisdn, \"0242602262\")) == 9, \"233\" + coalesce(phoneNo, msisdn, \"0242602262\"), coalesce(phoneNo, msisdn, \"0242602262\")))))}"
      },
      "next": "call_buy_ticket"
    },
    {
      "id": "call_buy_ticket",
      "type": "command",
      "command": "http.post",
      "label": "Buy Raffle Ticket API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/ticket/buy",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "raffleId": "$raffle_id",
          "selectedOptionValue": "$selected_option_id",
          "ticketGroupId": "$ticket_group_id",
          "customerPhone": "$customer_phone",
          "paymentMethod": "${coalesce(paymentMethod, \"Mobile Money\")}",
          "purchaseChannel": "${coalesce(purchaseChannel, \"USSD\")}",
          "provider": "${lower(coalesce(provider, network, \"mtn\"))}"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "buy_response": "$.body",
        "buy_message": "$.body.message"
      },
      "on_error": "buy_transport_error",
      "next": "buy_ticket_result"
    },
    {
      "id": "buy_ticket_result",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(buy_message, \"Authorize payment by entering your PIN on your mobile device. If no bill prompt appears, dial *170# to resume.\")}",
        "action": "buy_ticket",
        "api_success": "${coalesce(buy_response.success, false)}",
        "raffle": "$raffle_name",
        "raffleId": "$raffle_id",
        "selectedOptionValue": "$selected_option_id",
        "ticketGroup": "$ticket_group_name",
        "ticketGroupId": "$ticket_group_id",
        "quantity": "${to_number(coalesce(ticket_quantity, 0))}",
        "customerPhone": "$customer_phone"
      }
    },
    {
      "id": "buy_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the ticket purchase service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "buy_ticket",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "raffles_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the raffle service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "get_active_raffles",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "raffles_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(raffles_response.message, \"Failed to retrieve active raffles. Please try again.\")}",
        "success": false,
        "action": "get_active_raffles"
      }
    },
    {
      "id": "raffles_none",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "There are no active raffles at the moment. Please check back later.",
        "action": "get_active_raffles"
      }
    },
    {
      "id": "options_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the raffle options service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "get_active_raffle_options",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "options_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(options_response.message, \"Failed to retrieve raffle options. Please try again.\")}",
        "success": false,
        "action": "get_active_raffle_options"
      }
    },
    {
      "id": "options_none",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "This raffle has no options available yet. Please try again later.",
        "action": "get_active_raffle_options"
      }
    },
    {
      "id": "groups_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the ticket selection service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "get_ticket_groups",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "groups_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(groups_response.message, \"Failed to retrieve ticket options. Please try again.\")}",
        "success": false,
        "action": "get_ticket_groups"
      }
    },
    {
      "id": "groups_none",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "No ticket packages are available at the moment. Please check back later.",
        "action": "get_ticket_groups"
      }
    },
    {
      "id": "my_tickets",
      "type": "action",
      "capability": "",
      "label": "My Tickets PIN Authorization",
      "await_input": true,
      "input_variable": "user_pin",
      "prompt_config": {
        "message": "My Tickets\nEnter 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "set_tickets_context"
    },
    {
      "id": "set_tickets_context",
      "type": "noop",
      "label": "Normalize phone number to 233 format for My Tickets APIs",
      "assign": {
        "customer_phone": "${if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"+233\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 4), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"233\") && len(coalesce(phoneNo, msisdn, \"0242602262\")) == 12, coalesce(phoneNo, msisdn, \"0242602262\"), if(len(coalesce(phoneNo, msisdn, \"0242602262\")) == 9, \"233\" + coalesce(phoneNo, msisdn, \"0242602262\"), coalesce(phoneNo, msisdn, \"0242602262\")))))}"
      },
      "next": "call_ticket_summary"
    },
    {
      "id": "call_ticket_summary",
      "type": "command",
      "command": "http.post",
      "label": "Fetch Customer Ticket Summary API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/customers/get-ticket-summary",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "phoneNo": "$customer_phone",
          "pin": "${to_string(user_pin)}"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "tickets_response": "$.body",
        "ticket_list": "$.body.result.data",
        "tickets_message": "$.body.message"
      },
      "on_error": "tickets_transport_error",
      "next": "check_tickets_response"
    },
    {
      "id": "check_tickets_response",
      "type": "if",
      "label": "Check Ticket Summary API Response",
      "condition": "tickets_response != null && tickets_response.success == true",
      "then": "check_tickets_empty",
      "else": "tickets_rejection"
    },
    {
      "id": "check_tickets_empty",
      "type": "if",
      "label": "Check if the customer has any tickets",
      "condition": "is_array(ticket_list) && len(ticket_list) > 0",
      "then": "menu_tickets",
      "else": "tickets_none"
    },
    {
      "id": "menu_tickets",
      "type": "action",
      "capability": "",
      "label": "My Tickets Selection Menu",
      "await_input": true,
      "input_variable": "ticket_choice",
      "prompt_config": {
        "message": "${'My Tickets:\n' + join(map(ticket_list, (index + 1) + '. ' + item.ticketAlias + ' - ' + item.raffleName + ' (' + item.quantity + ' Tickets)'), '\n') + '\n0. Back'}",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]$')",
        "timeout": "2m"
      },
      "next": "check_tickets_back"
    },
    {
      "id": "check_tickets_back",
      "type": "if",
      "label": "Check if User entered 0 to go Back",
      "condition": "ticket_choice == '0' || ticket_choice == 0",
      "then": "main_menu",
      "else": "check_tickets_range"
    },
    {
      "id": "check_tickets_range",
      "type": "if",
      "label": "Validate selected ticket number",
      "condition": "to_number(ticket_choice) >= 1 && to_number(ticket_choice) <= len(ticket_list)",
      "then": "set_selected_ticket",
      "else": "menu_tickets"
    },
    {
      "id": "set_selected_ticket",
      "type": "noop",
      "label": "Record Selected Ticket",
      "assign": {
        "selected_raffle_id": "${get(ticket_list, '[' + to_string(to_number(ticket_choice) - 1) + ']', null).raffleId}",
        "selected_ticket_alias": "${get(ticket_list, '[' + to_string(to_number(ticket_choice) - 1) + ']', null).ticketAlias}",
        "selected_raffle_name": "${get(ticket_list, '[' + to_string(to_number(ticket_choice) - 1) + ']', null).raffleName}"
      },
      "next": "call_raffle_stats"
    },
    {
      "id": "call_raffle_stats",
      "type": "command",
      "command": "http.get",
      "label": "Fetch Raffle Stats API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/raffle/get-raffle-stats",
        "query": {
          "raffleId": "$selected_raffle_id"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "stats_response": "$.body",
        "stats_message": "$.body.message"
      },
      "on_error": "stats_transport_error",
      "next": "check_stats_response"
    },
    {
      "id": "check_stats_response",
      "type": "if",
      "label": "Check Raffle Stats API Response",
      "condition": "stats_response != null && stats_response.success == true",
      "then": "stats_display",
      "else": "stats_rejection"
    },
    {
      "id": "stats_display",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(stats_message, \"Raffle stats are not available at the moment.\")}",
        "action": "raffle_stats",
        "raffleId": "$selected_raffle_id",
        "ticketAlias": "$selected_ticket_alias",
        "raffleName": "$selected_raffle_name"
      }
    },
    {
      "id": "stats_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(stats_message, \"Failed to retrieve raffle stats. Please try again.\")}",
        "success": false,
        "action": "raffle_stats",
        "raffleId": "$selected_raffle_id",
        "ticketAlias": "$selected_ticket_alias"
      }
    },
    {
      "id": "stats_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the raffle stats service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "raffle_stats",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "tickets_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(tickets_message, \"Failed to retrieve your tickets. Please check your PIN and try again.\")}",
        "success": false,
        "action": "my_tickets"
      }
    },
    {
      "id": "tickets_none",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "You have no tickets yet. Select Buy Tickets to enter the next raffle draw.",
        "action": "my_tickets"
      }
    },
    {
      "id": "tickets_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the ticket service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "my_tickets",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "call_weekly_raffles",
      "type": "command",
      "command": "http.get",
      "label": "Fetch Weekly Raffles API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/raffle/get-weekly",
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "weekly_response": "$.body",
        "weekly_list": "$.body.result"
      },
      "on_error": "weekly_transport_error",
      "next": "check_weekly_response"
    },
    {
      "id": "check_weekly_response",
      "type": "if",
      "label": "Check Weekly Raffles API Response",
      "condition": "weekly_response != null && weekly_response.success == true",
      "then": "check_weekly_empty",
      "else": "weekly_rejection"
    },
    {
      "id": "check_weekly_empty",
      "type": "if",
      "label": "Check if any weekly raffles were returned",
      "condition": "is_array(weekly_list) && len(weekly_list) > 0",
      "then": "menu_weekly",
      "else": "weekly_none"
    },
    {
      "id": "menu_weekly",
      "type": "action",
      "capability": "",
      "label": "Upcoming Raffles Selection Menu",
      "await_input": true,
      "input_variable": "weekly_choice",
      "prompt_config": {
        "message": "${'Upcoming Raffles:\n' + join(map(weekly_list, (index + 1) + '. ' + item.name), '\n') + '\n0. Back'}",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-9]$')",
        "timeout": "2m"
      },
      "next": "check_weekly_back"
    },
    {
      "id": "check_weekly_back",
      "type": "if",
      "label": "Check if User entered 0 to go Back",
      "condition": "weekly_choice == '0' || weekly_choice == 0",
      "then": "main_menu",
      "else": "check_weekly_range"
    },
    {
      "id": "check_weekly_range",
      "type": "if",
      "label": "Validate selected raffle number",
      "condition": "to_number(weekly_choice) >= 1 && to_number(weekly_choice) <= len(weekly_list)",
      "then": "set_selected_weekly",
      "else": "menu_weekly"
    },
    {
      "id": "set_selected_weekly",
      "type": "noop",
      "label": "Record Selected Weekly Raffle",
      "assign": {
        "selected_raffle_id": "${get(weekly_list, '[' + to_string(to_number(weekly_choice) - 1) + ']', null).raffleId}",
        "selected_raffle_name": "${get(weekly_list, '[' + to_string(to_number(weekly_choice) - 1) + ']', null).name}",
        "selected_ticket_alias": ""
      },
      "next": "call_raffle_stats"
    },
    {
      "id": "weekly_rejection",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(weekly_response.message, \"Failed to retrieve upcoming raffles. Please try again.\")}",
        "success": false,
        "action": "upcoming_raffles"
      }
    },
    {
      "id": "weekly_none",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "There are no upcoming raffles at the moment. Please check back later.",
        "action": "upcoming_raffles"
      }
    },
    {
      "id": "weekly_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the upcoming raffles service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "upcoming_raffles",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "set_account_context",
      "type": "noop",
      "label": "Normalize phone number for Account APIs",
      "assign": {
        "local_phone": "${if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"+233\"), \"0\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 4), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"233\") && len(coalesce(phoneNo, msisdn, \"0242602262\")) == 12, \"0\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 3), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"0\"), coalesce(phoneNo, msisdn, \"0242602262\"), if(len(coalesce(phoneNo, msisdn, \"0242602262\")) == 9, \"0\" + coalesce(phoneNo, msisdn, \"0242602262\"), coalesce(phoneNo, msisdn, \"0242602262\")))))}",
        "customer_phone": "${if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"+233\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 4), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"0\"), \"233\" + substring(coalesce(phoneNo, msisdn, \"0242602262\"), 1), if(starts_with(coalesce(phoneNo, msisdn, \"0242602262\"), \"233\") && len(coalesce(phoneNo, msisdn, \"0242602262\")) == 12, coalesce(phoneNo, msisdn, \"0242602262\"), if(len(coalesce(phoneNo, msisdn, \"0242602262\")) == 9, \"233\" + coalesce(phoneNo, msisdn, \"0242602262\"), coalesce(phoneNo, msisdn, \"0242602262\")))))}"
      },
      "next": "menu_account"
    },
    {
      "id": "menu_account",
      "type": "action",
      "capability": "",
      "label": "Account Menu",
      "await_input": true,
      "input_variable": "account_choice",
      "prompt_config": {
        "message": "Account\n1. Get Login PIN\n2. Reset PIN\n3. Change PIN\n0. Back",
        "interaction_type": "menu",
        "input_validation": "matches(input, '^[0-3]$')",
        "timeout": "2m"
      },
      "next": "route_account"
    },
    {
      "id": "route_account",
      "type": "choice",
      "label": "Route Account selection",
      "expression": "$account_choice",
      "cases": {
        "0": "main_menu",
        "1": "call_get_login_pin",
        "2": "call_reset_pin",
        "3": "account_old_pin"
      },
      "default": "menu_account"
    },
    {
      "id": "call_get_login_pin",
      "type": "command",
      "command": "http.get",
      "label": "Get Customer Login PIN API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/auth/customer/get-login-pin",
        "query": {
          "phoneNumber": "$local_phone"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "login_pin_response": "$.body",
        "login_pin_message": "$.body.message"
      },
      "on_error": "login_pin_transport_error",
      "next": "get_login_pin_result"
    },
    {
      "id": "get_login_pin_result",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(login_pin_message, \"Your Login PIN could not be retrieved at the moment. Please try again.\")}",
        "action": "get_login_pin",
        "api_success": "${coalesce(login_pin_response.success, false)}"
      }
    },
    {
      "id": "login_pin_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the Login PIN service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "get_login_pin",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "call_reset_pin",
      "type": "command",
      "command": "http.get",
      "label": "Reset Customer PIN API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/auth/customer/reset-pin",
        "query": {
          "phoneNumber": "$customer_phone"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "reset_pin_response": "$.body",
        "reset_pin_message": "$.body.message"
      },
      "on_error": "reset_pin_transport_error",
      "next": "reset_pin_result"
    },
    {
      "id": "reset_pin_result",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(reset_pin_message, \"Your PIN could not be reset at the moment. Please try again.\")}",
        "action": "reset_pin",
        "api_success": "${coalesce(reset_pin_response.success, false)}"
      }
    },
    {
      "id": "reset_pin_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the PIN reset service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "reset_pin",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "account_old_pin",
      "type": "action",
      "capability": "",
      "label": "Enter Old PIN",
      "await_input": true,
      "input_variable": "account_old_pin",
      "prompt_config": {
        "message": "Change PIN\nEnter Old 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "account_new_pin"
    },
    {
      "id": "account_new_pin",
      "type": "action",
      "capability": "",
      "label": "Enter New PIN",
      "await_input": true,
      "input_variable": "account_new_pin",
      "prompt_config": {
        "message": "Enter New 4-digit PIN:",
        "interaction_type": "pin",
        "input_validation": "matches(input, '^[0-9]{4}$')",
        "timeout": "2m"
      },
      "next": "call_change_pin"
    },
    {
      "id": "call_change_pin",
      "type": "command",
      "command": "http.post",
      "label": "Change Customer PIN API",
      "http_request": {
        "url": "https://nsaa-api.rhyoliteprime.com/api/v1/auth/customer/change-pin",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "phoneNumber": "$local_phone",
          "oldPin": "${to_string(account_old_pin)}",
          "newPin": "${to_string(account_new_pin)}"
        },
        "timeout": "10s"
      },
      "retry": {
        "max_attempts": 2,
        "backoff_ms": 300,
        "multiplier": 2
      },
      "output": {
        "change_pin_response": "$.body",
        "change_pin_message": "$.body.message"
      },
      "on_error": "change_pin_transport_error",
      "next": "change_pin_result"
    },
    {
      "id": "change_pin_result",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(change_pin_message, \"Your PIN could not be changed at the moment. Please try again.\")}",
        "action": "change_pin",
        "api_success": "${coalesce(change_pin_response.success, false)}"
      }
    },
    {
      "id": "change_pin_transport_error",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "${coalesce(error.data.body.message, \"Dear customer, the PIN change service is temporarily unavailable. Please try again in a few moments.\")}",
        "success": false,
        "action": "change_pin",
        "error_code": "${coalesce(error.code, \"HTTP_ERROR\")}",
        "error_detail": "${coalesce(error.message, \"Network unreachable\")}",
        "response_body": "$error.data.body"
      }
    },
    {
      "id": "help_support",
      "type": "terminate",
      "status": "success",
      "output": {
        "message": "Help and Support\n\n*** Contact Us Info ***\nCall us: 0244256444\nWhatsapp: 0244256444\nFacebook: ChopMoney GH\nEmail: info@nsaaplay.com",
        "action": "help_support"
      }
    }
  ]
}
